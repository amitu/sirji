[Unit]
Description=iroh relay (sirji)
Documentation=https://github.com/amitu/sirji
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=iroh-relay
Group=iroh-relay
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/relay.toml
Restart=on-failure
RestartSec=5s

# Ports 80 and 443 are privileged and the service does not run as root, so grant
# just the one capability that allows binding them.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Let's Encrypt certificates are written here and must survive a restart.
StateDirectory=iroh-relay
StateDirectoryMode=0700

# A relay forwards bytes it cannot read. It has no business touching anything
# else on the box, so it is confined accordingly.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6

# Metrics and logs are chatty; keep them out of the journal's way.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

[Install]
WantedBy=multi-user.target
